{
  "name": "dachuan-atlas",
  "private": true,
  "version": "0.7.0",
  "description": "DACHUAN ATLAS — 大川项目架构星图 / P2.0-A CRM 独立导入管线准备",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:graphify": "tsc -p tsconfig.tools.json && node tools/import-graphify.mjs",
    "import:crm": "tsc -p tsconfig.tools.json && node tools/import-crm.mjs",
    "attach:flows": "node tools/attach-flows.mjs",
    "attach:explanations": "node tools/attach-explanations.mjs",
    "verify:build": "node tools/verify-build.mjs",
    "verify:chrome": "node tools/verify-chrome.mjs",
    "verify:p13": "node tools/verify-p13.mjs",
    "verify:p14": "node tools/verify-p14.mjs",
    "verify:p20a": "tsc -p tsconfig.tools.json && node tools/verify-p20a.mjs",
    "audit:backup": "node tools/audit-backup.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
